{
  "schema_version": 1,
  "skill_name": "ui-delivery",
  "cases": [
    {
      "id": "RR1",
      "prompt": "Это экран небольшого внутреннего приложения для инженеров обслуживания зданий. Перед показом пользователям его нужно довести: найди и исправь проблемы интерфейса и проверь результат в браузере. Поддерживаемые ширины окна — от 390 до 1440 px. Экран — список заявок. Он сгруппирован по корпусам (заголовки разделов), архив свёрнут под раскрывающимся пунктом, подзадачи показываются под своей заявкой с отступом уровня. Используй навык ui-delivery. Playwright с Chromium установлен в node_modules этого каталога. Работай только внутри этого каталога: не делай коммитов, не создавай задач и не пиши в память. В конце коротко перечисли, что нашёл, что исправил и чем проверил.",
      "files": {
        "index.html": "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Заявки — обслуживание зданий</title>\n<style>\n  :root {\n    --bg: #f4f5f7;\n    --surface: #ffffff;\n    --border: #e1e5ea;\n    --text: #1d232b;\n    --muted: #5b6573;\n    --accent: #2457c5;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--text);\n    background: var(--bg);\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; font-size: 15px; line-height: 1.45; }\n  .topbar {\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 14px 32px;\n    font-weight: 600;\n  }\n  .page { padding: 24px 32px 40px; }\n  .page-title { font-size: 22px; line-height: 1.3; margin: 0 0 4px; }\n  .page-note { margin: 0 0 20px; color: var(--muted); }\n  .column {\n    width: 340px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 16px;\n  }\n  .group {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    margin: 20px 0 6px;\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--muted);\n  }\n  .group:first-child { margin-top: 0; }\n  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--dot); }\n  .requests { list-style: none; margin: 0; padding: 0; }\n  .request { padding: 10px 8px; border-top: 1px solid var(--border); }\n  .request-title { font-weight: 500; }\n  .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }\n  .chip {\n    font-size: 12px;\n    line-height: 20px;\n    padding: 0 8px;\n    border-radius: 10px;\n    background: #eef1f4;\n    color: #3d4652;\n  }\n  .chip.warn { background: #fde8e6; color: #9b2c1f; }\n  .chip.wait { background: #fdf1d8; color: #7a5300; }\n  .subtasks { list-style: none; margin: 8px 0 0; padding: 0 0 0 20px; }\n  .subtask { font-size: 14px; color: var(--muted); padding: 3px 0; }\n  .archive { margin-top: 4px; border-top: 1px solid var(--border); padding-top: 6px; }\n  .archive-toggle {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    width: 100%;\n    padding: 6px 0;\n    border: 0;\n    border-radius: 6px;\n    background: none;\n    color: var(--text);\n    font: inherit;\n    font-weight: 600;\n    text-align: left;\n    cursor: pointer;\n  }\n  .archive-toggle:hover { color: var(--accent); }\n  .archive-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n  .chevron { width: 14px; height: 14px; flex: none; transition: transform 0.15s ease; }\n  .archive-toggle[aria-expanded=\"true\"] .chevron { transform: rotate(90deg); }\n  .archive .requests { margin-top: 4px; }\n  @media (max-width: 600px) {\n    .topbar { padding: 12px 16px; }\n    .page { padding: 16px 16px 32px; }\n    .column { width: 100%; }\n  }\n</style>\n</head>\n<body>\n<div class=\"topbar\">Обслуживание зданий</div>\n<main class=\"page\">\n  <h1 class=\"page-title\">Заявки</h1>\n  <p class=\"page-note\">Открытые заявки по корпусам на этой неделе.</p>\n  <section class=\"column\" aria-label=\"Список заявок\">\n    <div id=\"groups\"></div>\n    <div class=\"archive\">\n      <button type=\"button\" class=\"archive-toggle\" aria-expanded=\"false\" aria-controls=\"archive-list\">\n        <svg class=\"chevron\" viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M5 3l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        <span>Архив (3)</span>\n      </button>\n      <ul class=\"requests\" id=\"archive-list\" hidden></ul>\n    </div>\n  </section>\n</main>\n<script>\n  const groups = [\n    {\n      name: 'Корпус А',\n      color: '#d08a00',\n      items: [\n        { title: 'Протечка под раковиной в санузле, 2 этаж', priority: 'обычный', status: 'можно брать' },\n        { title: 'Не закрывается дверь на лестничную клетку', priority: 'высокий', status: 'можно брать' },\n        {\n          title: 'Плановый осмотр вентиляции на кровле',\n          priority: 'обычный',\n          status: 'можно брать',\n          subtasks: ['Проверить крепление вентиляторов', 'Очистить решётки воздухозаборников'],\n        },\n        { title: 'Шумит насос в тепловом пункте', priority: 'обычный', status: 'можно брать' },\n        { title: 'Заменить ламели жалюзи в переговорной 305', priority: 'обычный', status: 'можно брать' },\n      ],\n    },\n    {\n      name: 'Корпус Б',\n      color: '#2f9e5b',\n      items: [\n        { title: 'Не работает домофон у центрального входа', priority: 'обычный', status: 'ждёт деталей' },\n        { title: 'Течёт кран в комнате отдыха, 1 этаж', priority: 'обычный', status: 'можно брать' },\n        { title: 'Сломан доводчик на двери склада', priority: 'обычный', status: 'можно брать' },\n        { title: 'Мигает свет на парковке, уровень −1', priority: 'обычный', status: 'можно брать' },\n        { title: 'Проверить пожарные датчики в серверной', priority: 'обычный', status: 'можно брать' },\n      ],\n    },\n  ];\n  const archived = [\n    { title: 'Заменить картридж фильтра воды на кухне', priority: 'обычный', status: 'закрыта' },\n    { title: 'Починить замок шкафа в раздевалке', priority: 'обычный', status: 'закрыта' },\n    { title: 'Покрасить перила у запасного выхода', priority: 'обычный', status: 'закрыта' },\n  ];\n\n  function el(tag, className, text) {\n    const node = document.createElement(tag);\n    if (className) node.className = className;\n    if (text) node.textContent = text;\n    return node;\n  }\n\n  function chip(text, tone) {\n    return el('span', tone ? 'chip ' + tone : 'chip', text);\n  }\n\n  function renderRequest(request) {\n    const item = el('li', 'request');\n    item.append(el('div', 'request-title', request.title));\n    const meta = el('div', 'meta');\n    meta.append(chip('Приоритет: ' + request.priority, request.priority === 'высокий' ? 'warn' : ''));\n    meta.append(chip('Статус: ' + request.status, request.status === 'ждёт деталей' ? 'wait' : ''));\n    item.append(meta);\n    if (request.subtasks) {\n      const list = el('ul', 'subtasks');\n      for (const text of request.subtasks) list.append(el('li', 'subtask', text));\n      item.append(list);\n    }\n    return item;\n  }\n\n  const groupsRoot = document.getElementById('groups');\n  for (const group of groups) {\n    const heading = el('h2', 'group');\n    const dot = el('span', 'dot');\n    dot.style.setProperty('--dot', group.color);\n    heading.append(dot, group.name);\n    const list = el('ul', 'requests');\n    for (const request of group.items) list.append(renderRequest(request));\n    groupsRoot.append(heading, list);\n  }\n\n  const archiveList = document.getElementById('archive-list');\n  for (const request of archived) archiveList.append(renderRequest(request));\n\n  const toggle = document.querySelector('.archive-toggle');\n  toggle.addEventListener('click', () => {\n    const open = toggle.getAttribute('aria-expanded') === 'true';\n    toggle.setAttribute('aria-expanded', String(!open));\n    archiveList.hidden = open;\n  });\n</script>\n</body>\n</html>\n"
      }
    },
    {
      "id": "RR2",
      "prompt": "Это экран небольшого внутреннего приложения для инженеров обслуживания зданий. Перед показом пользователям его нужно довести: найди и исправь проблемы интерфейса и проверь результат в браузере. Поддерживаемые ширины окна — от 390 до 1440 px. Экран — карточка заявки. На узкой ширине тексты переносятся, а не обрезаются. Используй навык ui-delivery. Playwright с Chromium установлен в node_modules этого каталога. Работай только внутри этого каталога: не делай коммитов, не создавай задач и не пиши в память. В конце коротко перечисли, что нашёл, что исправил и чем проверил.",
      "files": {
        "index.html": "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Заявка № 1047 — обслуживание зданий</title>\n<style>\n  :root {\n    --bg: #f4f5f7;\n    --surface: #ffffff;\n    --border: #e1e5ea;\n    --text: #1d232b;\n    --muted: #5b6573;\n    --accent: #2457c5;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--text);\n    background: var(--bg);\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; font-size: 15px; line-height: 1.5; }\n  .topbar {\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 14px 32px;\n    font-weight: 600;\n  }\n  .page { padding: 24px 32px 40px; }\n  .card {\n    max-width: 720px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 24px;\n  }\n  .number { margin: 0 0 12px; font-size: 13px; color: var(--muted); }\n  .head { display: flex; align-items: flex-start; gap: 12px; }\n  .head-icon { width: 24px; height: 24px; flex: none; margin-top: 2px; color: var(--accent); }\n  .title { margin: 0; min-width: 0; font-size: 20px; line-height: 28px; font-weight: 600; }\n  .details { margin: 6px 0 0; text-indent: 36px; font-size: 14px; color: var(--muted); }\n  .section-title { margin: 24px 0 8px; font-size: 16px; line-height: 24px; }\n  .description { margin: 0; }\n  .progress { margin: 0 0 4px; font-size: 14px; color: var(--muted); }\n  .steps { list-style: none; margin: 0 0 0 -11px; padding: 0; }\n  .step { display: flex; align-items: flex-start; gap: 6px; cursor: pointer; }\n  .hit { position: relative; width: 40px; height: 40px; flex: none; display: grid; place-items: center; }\n  .hit input {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    opacity: 0;\n    cursor: pointer;\n  }\n  .box {\n    width: 18px;\n    height: 18px;\n    border: 2px solid #8a94a3;\n    border-radius: 4px;\n    background: var(--surface);\n    display: grid;\n    place-items: center;\n  }\n  .box svg { width: 12px; height: 12px; visibility: hidden; }\n  .hit input:checked + .box { background: var(--accent); border-color: var(--accent); color: #ffffff; }\n  .hit input:checked + .box svg { visibility: visible; }\n  .hit input:focus-visible + .box { outline: 2px solid var(--accent); outline-offset: 2px; }\n  .step-text { line-height: 28px; }\n  .step:has(input:checked) .step-text { color: var(--muted); }\n  @media (max-width: 600px) {\n    .topbar { padding: 12px 16px; }\n    .page { padding: 16px 16px 32px; }\n    .card { padding: 16px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"topbar\">Обслуживание зданий</div>\n<main class=\"page\">\n  <article class=\"card\">\n    <p class=\"number\">Заявка № 1047</p>\n    <div class=\"head\">\n      <svg class=\"head-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.2L4 16.8V20h3.2l5.3-5.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.4-.4-2.4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n      <h1 class=\"title\">Замена фильтров приточной установки и проверка датчика давления в техническом помещении</h1>\n    </div>\n    <p class=\"details\">Корпус А · 3 этаж · создана 4 ноября · исполнитель Ирина Н. · срок 8 ноября</p>\n\n    <h2 class=\"section-title\">Описание</h2>\n    <p class=\"description\">Приточная установка в техническом помещении третьего этажа подаёт заметно меньше воздуха, чем обычно. Фильтры последний раз меняли в мае, и датчик перепада давления с тех пор показывает завышенные значения. Нужно заменить фильтры, затем сверить показания датчика с переносным манометром. Если расхождение сохранится, датчик стоит заменить в рамках этой же заявки.</p>\n\n    <h2 class=\"section-title\">Шаги работ</h2>\n    <p class=\"progress\" id=\"progress\" aria-live=\"polite\"></p>\n    <ul class=\"steps\">\n      <li>\n        <label class=\"step\">\n          <span class=\"hit\"><input type=\"checkbox\" checked><span class=\"box\" aria-hidden=\"true\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2l2.3 2.3 4.7-4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span>\n          <span class=\"step-text\">Отключить приточную установку</span>\n        </label>\n      </li>\n      <li>\n        <label class=\"step\">\n          <span class=\"hit\"><input type=\"checkbox\"><span class=\"box\" aria-hidden=\"true\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2l2.3 2.3 4.7-4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span>\n          <span class=\"step-text\">Заменить фильтры G4 и F7</span>\n        </label>\n      </li>\n      <li>\n        <label class=\"step\">\n          <span class=\"hit\"><input type=\"checkbox\"><span class=\"box\" aria-hidden=\"true\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2l2.3 2.3 4.7-4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span>\n          <span class=\"step-text\">Сверить показания датчика перепада давления с переносным манометром</span>\n        </label>\n      </li>\n      <li>\n        <label class=\"step\">\n          <span class=\"hit\"><input type=\"checkbox\"><span class=\"box\" aria-hidden=\"true\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2l2.3 2.3 4.7-4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span>\n          <span class=\"step-text\">Запустить установку и записать расход воздуха</span>\n        </label>\n      </li>\n    </ul>\n  </article>\n</main>\n<script>\n  const boxes = Array.from(document.querySelectorAll('.steps input[type=\"checkbox\"]'));\n  const progress = document.getElementById('progress');\n  function updateProgress() {\n    const done = boxes.filter((box) => box.checked).length;\n    progress.textContent = 'Выполнено ' + done + ' из ' + boxes.length;\n  }\n  for (const box of boxes) box.addEventListener('change', updateProgress);\n  updateProgress();\n</script>\n</body>\n</html>\n"
      }
    },
    {
      "id": "RR3",
      "prompt": "Это экран небольшого внутреннего приложения для инженеров обслуживания зданий. Перед показом пользователям его нужно довести: найди и исправь проблемы интерфейса и проверь результат в браузере. Поддерживаемые ширины окна — от 390 до 1440 px. Экран — заявки участка. Список участка обновляется с сервера каждые 5 секунд; api.js имитирует сервер — его данные и задержки не меняй. Используй навык ui-delivery. Playwright с Chromium установлен в node_modules этого каталога. Работай только внутри этого каталога: не делай коммитов, не создавай задач и не пиши в память. В конце коротко перечисли, что нашёл, что исправил и чем проверил.",
      "files": {
        "index.html": "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Заявки участка — обслуживание зданий</title>\n<style>\n  :root {\n    --bg: #f4f5f7;\n    --surface: #ffffff;\n    --border: #e1e5ea;\n    --text: #1d232b;\n    --muted: #5b6573;\n    --accent: #2457c5;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--text);\n    background: var(--bg);\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; font-size: 15px; line-height: 1.45; }\n  .topbar {\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 14px 32px;\n    font-weight: 600;\n  }\n  .page { max-width: 820px; padding: 24px 32px 40px; }\n  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }\n  .page-title { margin: 0; font-size: 22px; line-height: 1.3; }\n  .select { position: relative; }\n  .select-trigger {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 40px;\n    padding: 0 12px 0 14px;\n    border: 1px solid #c9d0d8;\n    border-radius: 8px;\n    background: var(--surface);\n    color: var(--text);\n    font: inherit;\n    cursor: pointer;\n  }\n  .select-trigger:hover { border-color: #9aa4b1; }\n  .select-trigger:focus {\n    outline: none;\n    border-color: var(--accent);\n    box-shadow: 0 0 0 3px rgba(36, 87, 197, 0.35);\n  }\n  .select-trigger svg { width: 14px; height: 14px; flex: none; color: var(--muted); }\n  .listbox {\n    position: absolute;\n    right: 0;\n    top: calc(100% + 4px);\n    z-index: 10;\n    min-width: 200px;\n    margin: 0;\n    padding: 4px;\n    list-style: none;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    box-shadow: 0 8px 24px rgba(20, 30, 45, 0.14);\n  }\n  .listbox[hidden] { display: none; }\n  .option {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 8px 10px;\n    border-radius: 6px;\n    cursor: pointer;\n  }\n  .option:hover, .option:focus { background: #eef2fa; outline: none; }\n  .option svg { width: 14px; height: 14px; color: var(--accent); visibility: hidden; }\n  .option[aria-selected=\"true\"] { font-weight: 600; }\n  .option[aria-selected=\"true\"] svg { visibility: visible; }\n  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }\n  .requests { list-style: none; margin: 0; padding: 0; }\n  .request { padding: 12px 16px; border-top: 1px solid var(--border); }\n  .request:first-child { border-top: 0; }\n  .request-title { font-weight: 500; }\n  .request-meta { margin-top: 2px; font-size: 13px; color: var(--muted); }\n  .list-status { padding: 16px; color: var(--muted); }\n  @media (max-width: 600px) {\n    .topbar { padding: 12px 16px; }\n    .page { padding: 16px 16px 32px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"topbar\">Обслуживание зданий</div>\n<main class=\"page\">\n  <div class=\"toolbar\">\n    <h1 class=\"page-title\">Заявки участка</h1>\n    <div class=\"select\">\n      <button type=\"button\" class=\"select-trigger\" id=\"site-trigger\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"site-list\">\n        <span>Участок: <span id=\"site-label\">Северный</span></span>\n        <svg viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M3 5l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </button>\n      <ul class=\"listbox\" id=\"site-list\" role=\"listbox\" aria-label=\"Участок\" hidden></ul>\n    </div>\n  </div>\n  <section class=\"panel\" aria-label=\"Заявки\">\n    <ul class=\"requests\" id=\"requests\"></ul>\n  </section>\n</main>\n<script src=\"api.js\"></script>\n<script>\n  const SITES = ['Северный', 'Южный', 'Центральный'];\n  const REFRESH_MS = 5000;\n  const state = { site: 'Северный' };\n  let requestSeq = 0;\n\n  const trigger = document.getElementById('site-trigger');\n  const siteLabel = document.getElementById('site-label');\n  const listbox = document.getElementById('site-list');\n  const list = document.getElementById('requests');\n  const checkIcon = '<svg viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M2.5 7.2l3 3 6-6.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n\n  for (const site of SITES) {\n    const option = document.createElement('li');\n    option.className = 'option';\n    option.setAttribute('role', 'option');\n    option.tabIndex = -1;\n    option.dataset.value = site;\n    option.innerHTML = '<span></span>' + checkIcon;\n    option.firstChild.textContent = site;\n    listbox.append(option);\n  }\n  const options = Array.from(listbox.children);\n\n  function syncSelection() {\n    siteLabel.textContent = state.site;\n    for (const option of options) {\n      option.setAttribute('aria-selected', String(option.dataset.value === state.site));\n    }\n  }\n\n  function isOpen() {\n    return !listbox.hidden;\n  }\n\n  function open() {\n    listbox.hidden = false;\n    trigger.setAttribute('aria-expanded', 'true');\n    const selected = options.find((option) => option.dataset.value === state.site) || options[0];\n    selected.focus();\n  }\n\n  function close(returnFocus) {\n    listbox.hidden = true;\n    trigger.setAttribute('aria-expanded', 'false');\n    if (returnFocus) trigger.focus();\n  }\n\n  function choose(site) {\n    close(true);\n    if (site === state.site) return;\n    state.site = site;\n    syncSelection();\n    load();\n  }\n\n  trigger.addEventListener('click', () => {\n    if (isOpen()) close(false);\n    else open();\n  });\n\n  trigger.addEventListener('keydown', (event) => {\n    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {\n      event.preventDefault();\n      open();\n    }\n  });\n\n  listbox.addEventListener('click', (event) => {\n    const option = event.target.closest('[role=\"option\"]');\n    if (option) choose(option.dataset.value);\n  });\n\n  listbox.addEventListener('keydown', (event) => {\n    const index = options.indexOf(document.activeElement);\n    if (event.key === 'ArrowDown') {\n      event.preventDefault();\n      options[Math.min(index + 1, options.length - 1)].focus();\n    } else if (event.key === 'ArrowUp') {\n      event.preventDefault();\n      options[Math.max(index - 1, 0)].focus();\n    } else if (event.key === 'Home') {\n      event.preventDefault();\n      options[0].focus();\n    } else if (event.key === 'End') {\n      event.preventDefault();\n      options[options.length - 1].focus();\n    } else if (event.key === 'Enter' || event.key === ' ') {\n      event.preventDefault();\n      if (index >= 0) choose(options[index].dataset.value);\n    } else if (event.key === 'Escape') {\n      event.preventDefault();\n      close(true);\n    } else if (event.key === 'Tab') {\n      close(false);\n    }\n  });\n\n  document.addEventListener('pointerdown', (event) => {\n    if (isOpen() && !event.target.closest('.select')) close(false);\n  });\n\n  function statusRow(text) {\n    const row = document.createElement('li');\n    row.className = 'list-status';\n    row.textContent = text;\n    return row;\n  }\n\n  function renderList(items) {\n    const rows = items.map((item) => {\n      const row = document.createElement('li');\n      row.className = 'request';\n      const title = document.createElement('div');\n      title.className = 'request-title';\n      title.textContent = item.title;\n      const meta = document.createElement('div');\n      meta.className = 'request-meta';\n      meta.textContent = item.id + ' · ' + item.place + ' · ' + item.due;\n      row.append(title, meta);\n      return row;\n    });\n    list.replaceChildren(...rows);\n  }\n\n  async function load() {\n    const site = state.site;\n    const token = ++requestSeq;\n    list.replaceChildren(statusRow('Загрузка…'));\n    let items;\n    try {\n      items = await window.requestsApi.fetchSite(site);\n    } catch (error) {\n      if (token === requestSeq) list.replaceChildren(statusRow('Не удалось загрузить заявки. Повторим через несколько секунд.'));\n      return;\n    }\n    if (token !== requestSeq) return;\n    renderList(items);\n  }\n\n  syncSelection();\n  load();\n  setInterval(load, REFRESH_MS);\n</script>\n</body>\n</html>\n",
        "api.js": "// Имитация сервера заявок: фиксированные данные участков и задержка ответа.\n(function () {\n  const RESPONSE_DELAY_MS = 600;\n  const DATA = {\n    'Северный': [\n      { id: 'С-214', title: 'Заменить уплотнитель на воротах гаража', place: 'Корпус 1 · гараж', due: 'срок 7 ноября' },\n      { id: 'С-217', title: 'Прочистить ливнёвку у въезда', place: 'Территория · въезд', due: 'срок 8 ноября' },\n      { id: 'С-219', title: 'Отрегулировать доводчик в тамбуре', place: 'Корпус 2 · вход', due: 'срок 8 ноября' },\n      { id: 'С-222', title: 'Закрепить отходящий плинтус в коридоре', place: 'Корпус 1 · 2 этаж', due: 'срок 11 ноября' },\n      { id: 'С-225', title: 'Поменять лампы в подсобке', place: 'Корпус 2 · 1 этаж', due: 'срок 12 ноября' },\n    ],\n    'Южный': [\n      { id: 'Ю-108', title: 'Починить кодовый замок калитки', place: 'Территория · калитка', due: 'срок 7 ноября' },\n      { id: 'Ю-111', title: 'Убрать наледь с козырька', place: 'Корпус 3 · вход', due: 'срок 7 ноября' },\n      { id: 'Ю-112', title: 'Проверить давление в системе отопления', place: 'Корпус 3 · тепловой пункт', due: 'срок 9 ноября' },\n      { id: 'Ю-115', title: 'Заменить смеситель в душевой', place: 'Корпус 4 · 1 этаж', due: 'срок 10 ноября' },\n      { id: 'Ю-118', title: 'Подтянуть крепление поручня на лестнице', place: 'Корпус 4 · лестница Б', due: 'срок 13 ноября' },\n    ],\n    'Центральный': [\n      { id: 'Ц-301', title: 'Настроить таймер наружного освещения', place: 'Территория · парковка', due: 'срок 8 ноября' },\n      { id: 'Ц-304', title: 'Заменить разбитое стекло в двери', place: 'Корпус 5 · 1 этаж', due: 'срок 8 ноября' },\n      { id: 'Ц-306', title: 'Очистить дренаж кондиционера', place: 'Корпус 5 · 4 этаж', due: 'срок 10 ноября' },\n      { id: 'Ц-309', title: 'Устранить скрип двери в архиве', place: 'Корпус 6 · цокольный этаж', due: 'срок 12 ноября' },\n      { id: 'Ц-310', title: 'Проверить аварийное освещение', place: 'Корпус 6 · все этажи', due: 'срок 14 ноября' },\n    ],\n  };\n\n  window.requestsApi = {\n    fetchSite(site) {\n      return new Promise((resolve, reject) => {\n        setTimeout(() => {\n          if (!DATA[site]) reject(new Error('Неизвестный участок'));\n          else resolve(DATA[site].map((item) => ({ ...item })));\n        }, RESPONSE_DELAY_MS);\n      });\n    },\n  };\n})();\n"
      }
    }
  ]
}
