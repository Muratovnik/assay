{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(?!(?:Agent|Task|SubagentHandback)$)",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task|WebFetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/runtime/cli.py",
              "--client",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
